---
import { getCollection } from 'astro:content';
import SolutionDetail from '../../views/SolutionDetail.astro';
export async function getStaticPaths() {
  const entries = await getCollection('solutions', (e) => e.data.lang === 'tr');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
---
<SolutionDetail entry={entry} lang="tr" />
