---
import Logo from './Logo.astro';
import { useTranslations, r, alternatePath, otherLang } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const nav = [
  ['nav.solutions', r('solutions', lang)],
  ['nav.packages', r('packages', lang)],
  ['nav.about', r('about', lang)],
  ['nav.contact', r('contact', lang)],
] as const;
const alt = alternatePath(Astro.url.pathname, otherLang(lang));
---
<header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/90 backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between gap-6">
    <a href={r('home', lang)} aria-label="Luvita Enerji"><Logo /></a>
    <nav class="hidden items-center gap-7 text-sm font-medium text-slate-700 md:flex" aria-label="Main">
      {nav.map(([k, href]) => <a href={href} class="hover:text-primary-800">{t(k)}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <a href={alt} hreflang={otherLang(lang)} lang={otherLang(lang)} class="text-xs font-semibold uppercase tracking-wide text-slate-500 hover:text-primary-800">{t('lang.switch')}</a>
      <a href={r('quote', lang)} class="btn-primary hidden !py-2 md:inline-flex">{t('nav.quote')}</a>
      <button id="menu-btn" class="md:hidden rounded-lg p-2 text-primary-800" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white md:hidden">
    <nav class="container-x flex flex-col gap-1 py-3 text-base font-medium" aria-label="Mobile">
      {nav.map(([k, href]) => <a href={href} class="rounded-lg px-2 py-2.5 hover:bg-primary-50">{t(k)}</a>)}
      <a href={r('quote', lang)} class="btn-primary mt-2">{t('nav.quote')}</a>
    </nav>
  </div>
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu!.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
