---
import Icon from './Icon.astro';
import { r, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
const { s, lang } = Astro.props as { s: any; lang: Lang };
const t = useTranslations(lang);
---
<a href={r(s.data.routeKey, lang)} class="card group flex flex-col transition hover:-translate-y-0.5 hover:shadow-md">
  <span class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary-50 text-primary-800"><Icon name={s.data.icon} /></span>
  <h3 class="text-xl">{s.data.title}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{s.data.summary}</p>
  <ul class="mt-4 space-y-1.5 text-sm text-slate-700">
    {s.data.highlights.map((h: string) => <li class="flex gap-2"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-teal-600" />{h}</li>)}
  </ul>
  <span class="mt-5 text-sm font-semibold text-primary-800 group-hover:underline">{t('sol.more')} →</span>
</a>
