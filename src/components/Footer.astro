---
import Logo from './Logo.astro';
import { useTranslations, r } from '../i18n/utils';
import { site, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const year = new Date().getFullYear();
---
<footer class="mt-24 bg-primary-900 text-slate-300">
  <div class="container-x grid gap-10 py-14 md:grid-cols-4">
    <div class="md:col-span-2">
      <Logo variant="light" />
      <p class="mt-4 max-w-sm text-sm leading-relaxed">{t('footer.tagline')}</p>
      <p class="mt-3 text-xs text-slate-400">{t('footer.parent')}</p>
    </div>
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wider text-white">{t('nav.solutions')}</h3>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="hover:text-white" href={r('sol.rooftop', lang)}>{lang === 'tr' ? 'Çatı GES' : 'Rooftop solar'}</a></li>
        <li><a class="hover:text-white" href={r('sol.storage', lang)}>{lang === 'tr' ? 'Enerji depolama' : 'Energy storage'}</a></li>
        <li><a class="hover:text-white" href={r('sol.heatpump', lang)}>{lang === 'tr' ? 'Isı pompası' : 'Heat pumps'}</a></li>
        <li><a class="hover:text-white" href={r('packages', lang)}>{t('nav.packages')}</a></li>
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wider text-white">{t('nav.contact')}</h3>
      <ul class="mt-3 space-y-2 text-sm">
        <li>{site.address}</li>
        <li><a class="hover:text-white" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li>
        <li><a class="hover:text-white" href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
      <h3 class="mt-6 text-sm font-semibold uppercase tracking-wider text-white">{t('footer.legal')}</h3>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="hover:text-white" href={r('kvkk', lang)}>{t('footer.kvkk')}</a></li>
        <li><a class="hover:text-white" href={r('privacy', lang)}>{t('footer.privacy')}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x py-5 text-xs text-slate-400">© {year} {site.parent} {t('footer.rights')}</div>
  </div>
</footer>
