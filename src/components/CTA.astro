---
import { r, useTranslations, waLink } from '../i18n/utils';
import { site, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---
<section class="py-16">
  <div class="container-x">
    <div class="rounded-3xl bg-primary-800 px-8 py-12 text-white sm:px-12 md:flex md:items-center md:justify-between md:gap-10">
      <div class="max-w-xl">
        <h2 class="text-3xl text-white">{t('cta.title')}</h2>
        <p class="mt-3 text-slate-300">{t('cta.sub')}</p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3 md:mt-0">
        <a href={r('quote', lang)} class="btn-primary">{t('cta.btn')}</a>
        <a href={waLink(lang)} target="_blank" rel="noopener" class="btn-ghost">{t('cta.wa')}</a>
      </div>
    </div>
  </div>
</section>
