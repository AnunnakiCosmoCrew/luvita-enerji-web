---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { useTranslations } from '../i18n/utils';
import { site, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---
<Base lang={lang} title={t('form.title')} description={t('form.sub')}>
  <div class="container-x grid gap-12 py-14 lg:grid-cols-[1fr_360px]">
    <div>
      <p class="eyebrow">{t('nav.quote')}</p>
      <h1 class="mt-2 text-3xl sm:text-4xl">{t('form.title')}</h1>
      <p class="mt-3 max-w-xl text-slate-600">{t('form.sub')}</p>
      <div class="mt-8"><QuoteForm lang={lang} /></div>
    </div>
    <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
      <div class="card">
        <h2 class="text-lg">{lang === 'tr' ? 'Keşifte ne olur?' : 'What happens at the survey?'}</h2>
        <ul class="mt-3 space-y-2 text-sm text-slate-700">
          {(lang === 'tr'
            ? ['Çatı ölçümü, yön ve gölgelenme kontrolü','Sayaç, pano ve kablo altyapısının incelenmesi','Son 12 ay fatura üzerinden tüketim analizi','Yazılı teklif: bileşenler, üretim tahmini, amorti']
            : ['Roof measurement, orientation and shading check','Inspection of meter, switchboard and cabling','Consumption analysis from the last 12 months of bills','Written quote: components, generation estimate, payback']
          ).map((i) => <li class="flex gap-2"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-teal-600" />{i}</li>)}
        </ul>
      </div>
      <div class="card text-sm">
        <p class="font-semibold text-primary-800">{lang === 'tr' ? 'Hemen konuşmak isterseniz' : 'Prefer to talk now?'}</p>
        <a class="mt-2 block hover:underline" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
        <a class="mt-1 block hover:underline" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </aside>
  </div>
</Base>
